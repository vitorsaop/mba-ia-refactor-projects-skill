# Copiar para .env e preencher. Nenhum valor abaixo é obrigatório para o boot:
# os padrões do módulo de configuração preservam o comportamento documentado.

# Valores não secretos. O padrão é o literal que o projeto já usava.
DATABASE_URI=sqlite:///tasks.db
HOST=0.0.0.0
PORT=5000
DEBUG=false
LOG_LEVEL=INFO

# Origens permitidas para requisição cruzada, separadas por vírgula.
# Vazio significa nenhuma origem cruzada permitida.
CORS_ORIGINS=

# Segredos. Sem valor no código e sem valor aqui.
# SECRET_KEY ausente é gerada por boot: o projeto não assina nada com ela.
SECRET_KEY=
# ADMIN_TOKEN ausente faz as rotas de remoção recusarem toda requisição.
ADMIN_TOKEN=
