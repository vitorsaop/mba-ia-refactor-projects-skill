# Copiar para .env e preencher.
#
# O projeto lê estas variáveis direto do ambiente. Não há carregador de arquivo
# .env porque isso exigiria uma dependência nova, e a refatoração não acrescenta
# dependência. Exportar as variáveis no shell, ou usar o mecanismo do
# orquestrador, tem o mesmo efeito.

# Valores não secretos. O padrão de cada um é o literal que o projeto já tinha,
# portanto `npm start` funciona sem definir nenhuma delas.
PORT=3000
DB_FILE=:memory:
LOG_LEVEL=info
SQLITE_VERBOSE=false

# Senha do usuário da carga inicial. Padrão '123', o mesmo valor que o código
# original gravava. Só faz sentido em ambiente de demonstração.
SEED_USER_PASSWORD=

# Segredo. Sem valor padrão. Enquanto estiver vazia, GET /api/admin/financial-report
# e DELETE /api/users/:id recusam toda requisição com 401.
ADMIN_TOKEN=
